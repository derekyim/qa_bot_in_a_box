# ──────────────────────────────────────────────────────────────────────────────
# QA Bot in a Box — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM / Anthropic ──────────────────────────────────────────────────────────
# Your Anthropic API key (required for LLM judge and semantic runner)
ANTHROPIC_API_KEY=

# Model used for the LLM judge and semantic runner
# Default: claude-haiku-4-5-20251001  (fast and cheap)
# Alternatives: claude-sonnet-4-6, claude-opus-4-6
LLM_MODEL=claude-haiku-4-5-20251001

# ── Login credentials (optional) ─────────────────────────────────────────────
# If the target app requires authentication, fill in these values.
# Leave blank to skip the login flow.
LOGIN_URL=
LOGIN_USERNAME=
LOGIN_PASSWORD=
LOGIN_USERNAME_SELECTOR=#username
LOGIN_PASSWORD_SELECTOR=#password
LOGIN_SUBMIT_SELECTOR=button[type="submit"]

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Port for the local React status dashboard
DASHBOARD_PORT=3010

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory for all test data (test cases, runs, diffs, verdicts)
QA_DATA_DIR=./qa-data
